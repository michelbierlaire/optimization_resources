\newcommand{\includex}[4][]{
  \subsection{#4}
   \begin{flushright}
    \footnotesize\texttt{#2\_q#3.tex} \emph{#1}
  \end{flushright}
  \input{#2/#2_q#3}
  \subsection*{Solution}
   \begin{flushright}
    \footnotesize\texttt{#2\_a#3.tex} \emph{#1}
  \end{flushright}
   \input{#2/#2_a#3}
   \clearpage
}


\newcommand\grayheader[1]{
\begin{flushleft}
\begin{tabular}{p{\textwidth}}
\cellcolor[gray]{0.9} \textbf{#1}
\end{tabular}
\end{flushleft}
}

\newcommand{\includequestion}[3]{
  \grayheader{#3}
  \input{#1/#1_q#2}
  \clearpage
}

\newcommand{\includecorrige}[3]{
  \grayheader{#3}
  \input{#1/#1_a#2}
  \clearpage
}

